# Modèle de configuration de production. Copiez ce fichier en « .env » (même dossier), puis remplissez-le :
#   cp .env.example .env
# Le fichier .env n'est JAMAIS versionné : il contient vos secrets. Guide : docs/deploiement.md.

# --- Domaines et certificats HTTPS ---
# Deux noms de domaine qui pointent vers l'adresse IP du serveur (sans « https:// »).
BACK_DOMAIN=app.mondomaine.be
VITRINE_DOMAIN=resto.mondomaine.be
# Adresse e-mail transmise à Let's Encrypt (avis d'expiration).
ACME_EMAIL=

# --- Base de données ---
# Mot de passe de PostgreSQL. Générez-le : openssl rand -hex 24  (lettres et chiffres seulement).
POSTGRES_PASSWORD=

# --- Paiements ---
# Mollie (paiements réels ou de test) ou Demo (démonstration : aucun argent réel).
PAYMENTS_GATEWAY=Mollie
# Clé API Mollie (test_... ou live_...). Obligatoire si PAYMENTS_GATEWAY=Mollie.
MOLLIE_API_KEY=

# --- E-mails ---
# Smtp (envoi réel) ou Log (les e-mails ne sont pas envoyés ; réservé à une démonstration avec DEMO_SEED_ON_STARTUP=true :
# sans cela le premier compte ne pourrait pas être confirmé et le site refuse de démarrer).
EMAIL_SENDER=Smtp
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=ChefOS
SMTP_HOST=
SMTP_PORT=587
# StartTls (port 587 en général) ou SslOnConnect (port 465).
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Lecture des tickets fournisseurs ---
# Clé API Anthropic. Sans clé, chaque ticket téléversé échoue avec un message clair.
ANTHROPIC_API_KEY=
# Claude (par défaut) ou Demo (ticket factice, sans clé ni réseau).
RECEIPTS_READER=Claude

# --- Comptes ---
# Une fois le premier compte créé, l'inscription est fermée. Mettez true pour autoriser de nouveaux comptes.
ACCOUNTS_ALLOW_REGISTRATION=false

# --- Démonstration hébergée (laissez à false pour un vrai restaurant) ---
# true : remplit « Le Petit Bistro » au démarrage ; DEMO_EMAIL et DEMO_PASSWORD définissent le compte de démonstration.
DEMO_SEED_ON_STARTUP=false
DEMO_EMAIL=
DEMO_PASSWORD=
