@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using ChefOS.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Données personnelles — ChefOS</PageTitle>

<StatusMessage />
<h3>Données personnelles</h3>

<div class="row">
    <div class="col-md-6">
        <p>Votre compte contient des données personnelles que vous nous avez communiquées. Cette page vous permet de les télécharger ou de les supprimer.</p>
        <p>
            <strong>La suppression de ces données entraîne la suppression définitive de votre compte, sans possibilité de récupération.</strong>
        </p>
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">Télécharger</button>
        </form>
        <p>
            <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">Supprimer</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
