@page "/Account/Manage/ResetAuthenticator"

@using Microsoft.AspNetCore.Identity
@using ChefOS.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ResetAuthenticator> Logger

<PageTitle>Réinitialiser la clé d'authentification — ChefOS</PageTitle>

<StatusMessage />
<h3>Réinitialiser la clé d'authentification</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>Si vous réinitialisez votre clé d'authentification, votre application d'authentification ne fonctionnera plus tant que vous ne l'aurez pas reconfigurée.</strong>
    </p>
    <p>
        Cette opération désactive la double authentification jusqu'à ce que vous vérifiiez votre application d'authentification.
        Si vous ne terminez pas la configuration de votre application, vous risquez de perdre l'accès à votre compte.
    </p>
</div>
<div>
    <form @formname="reset-authenticator" @onsubmit="OnSubmitAsync" method="post">
        <AntiforgeryToken />
        <button class="btn btn-danger" type="submit">Réinitialiser la clé d'authentification</button>
    </form>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private async Task OnSubmitAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        await UserManager.SetTwoFactorEnabledAsync(user, false);
        await UserManager.ResetAuthenticatorKeyAsync(user);
        var userId = await UserManager.GetUserIdAsync(user);
        Logger.LogInformation("User with ID '{UserId}' has reset their authentication app key.", userId);

        await SignInManager.RefreshSignInAsync(user);

        RedirectManager.RedirectToWithStatus(
            "Account/Manage/EnableAuthenticator",
            "Votre clé d'authentification a été réinitialisée : vous devez configurer votre application d'authentification avec la nouvelle clé.",
            HttpContext);
    }
}
