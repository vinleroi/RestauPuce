@page "/"

@using ChefOS.Back.Components.Pages.Reservations
@using ChefOS.Core.Restaurants
@using ChefOS.Core.Vitrine
@using ChefOS.Infrastructure.Data
@using ChefOS.Infrastructure.Services

@inject DashboardService DashboardService
@inject RestaurantService RestaurantService
@inject ReservationService ReservationService
@inject VitrineService VitrineService
@inject TimeProvider Clock
@inject ITenantContext Tenant

<PageTitle>Tableau de bord — ChefOS</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Tableau de bord</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_summary is not null)
{
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="4">@Kpi("Plats", _summary.DishCount.ToString(Ui.Fr))</MudItem>
        <MudItem xs="12" sm="4">@Kpi("Préparations", _summary.PreparationCount.ToString(Ui.Fr))</MudItem>
        <MudItem xs="12" sm="4">@Kpi("Food cost moyen", _summary.AverageFoodCost is { } average ? Ui.Percent(average) : "—")</MudItem>
    </MudGrid>

    @if (_week is { } week)
    {
        <MudGrid Spacing="3" Class="mb-4">
            <MudItem xs="12" sm="6">
                @Kpi("CA HT (7 jours)", Ui.Money(week.RevenueExclVat), caption: WeekCaption(week))
            </MudItem>
            <MudItem xs="12" sm="6">
                @Kpi("Marge brute (7 jours)", Ui.Money(week.GrossMargin), incomplete: week.CostIncomplete, caption: WeekCaption(week))
            </MudItem>
        </MudGrid>
    }

    @if (_reservations is { Services.Count: > 0 } reservations)
    {
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <div class="d-flex align-center mb-2">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="flex-grow-1">Réservations du jour</MudText>
                <MudLink Href="/reservations">Voir les réservations</MudLink>
            </div>
            @foreach (var service in reservations.Services)
            {
                <div class="d-flex align-center gap-2 mb-1">
                    <MudText>@service.Name</MudText>
                    <MudSpacer />
                    <MudText Typo="Typo.subtitle2" Color="@(service.IsOverCapacity ? Color.Error : Color.Default)">@service.CoversText</MudText>
                </div>
                <MudProgressLinear Value="service.FillPercent" Min="0" Max="100" Rounded="true" Class="mb-2"
                                   Color="@(service.IsOverCapacity ? Color.Error : Color.Primary)" aria-label="@($"Remplissage du service {service.Name}")" />
            }
            @if (_nextGroup is { } group)
            {
                <MudText Typo="Typo.body2" Class="mt-2">
                    Prochain groupe : <strong>@group.Name</strong>, @group.PartySize couverts à @group.TimeText (@group.ServiceName)
                </MudText>
            }
        </MudPaper>
    }

    <MudPaper Elevation="1" Class="pa-4">
        <MudText Typo="Typo.h6" HtmlTag="h2" GutterBottom="true">Plats à surveiller</MudText>

        <MudTable T="WatchItem" Items="_summary.WatchList" Hover="true" Dense="true" Elevation="0">
            <HeaderContent>
                <MudTh>Plat</MudTh>
                <MudTh>Food cost</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Plat">
                    <MudLink Href="@($"/recipes/{context.RecipeId}")">@context.Name</MudLink>
                </MudTd>
                <MudTd DataLabel="Food cost">
                    <FoodCostChip Level="context.Level" FoodCostPercent="context.FoodCostPercent" Threshold="_threshold" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4">Aucun plat à surveiller 👌</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-4 mt-4">
        <MudText Typo="Typo.h6" HtmlTag="h2" GutterBottom="true">Variations de prix (@PriceChangeDays jours)</MudText>

        <MudTable T="PriceChange" Items="_priceChanges" Hover="true" Dense="true" Elevation="0">
            <HeaderContent>
                <MudTh>Ingrédient</MudTh>
                <MudTh>Prix</MudTh>
                <MudTh>Variation</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Ingrédient">
                    <MudLink Href="@($"/ingredients/{context.IngredientId}")">@context.Name</MudLink>
                </MudTd>
                <MudTd DataLabel="Prix">
                    @Ui.PricePerDisplayUnit(context.PreviousPrice, context.BaseUnit) → @Ui.PricePerDisplayUnit(context.CurrentPrice, context.BaseUnit)
                </MudTd>
                <MudTd DataLabel="Variation">
                    <PriceVariation Variation="context.ChangePercent" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4">Aucune variation notable</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@code {
    private static readonly Restaurant Defaults = new();

    // Fenêtre des variations de prix affichées (le titre du bloc reprend ce nombre de jours).
    private const int PriceChangeDays = 30;

    private DashboardSummary? _summary;
    private SevenDayFigures? _week;
    private IReadOnlyList<PriceChange> _priceChanges = [];
    private ReservationDayView? _reservations;
    private NextGroupView? _nextGroup;
    private decimal _threshold = Defaults.FoodCostAlertThreshold;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _summary = await DashboardService.GetSummaryAsync();
            _priceChanges = await DashboardService.GetRecentPriceChangesAsync(PriceChangeDays);
            _week = await DashboardService.GetLastSevenDaysAsync();

            // Le seuil sert à l'infobulle de la pastille rouge (« Au-dessus du seuil d'alerte (35 %) »).
            var restaurant = Tenant.CurrentRestaurantId is { } restaurantId ? await RestaurantService.GetAsync(restaurantId) : null;
            _threshold = restaurant?.FoodCostAlertThreshold ?? Defaults.FoodCostAlertThreshold;

            if (restaurant is not null)
                await LoadReservationsAsync(restaurant.TimeZoneId);
        }
        finally
        {
            _loading = false;
        }
    }

    // Les couverts du jour par service et le prochain grand groupe, calculés par la même vue que l'écran des réservations.
    // Un restaurant sans vitrine n'a pas de service : le bloc n'apparaît pas (et aucun profil n'est créé ici).
    private async Task LoadReservationsAsync(string timeZoneId)
    {
        var now = Clock.GetUtcNow().UtcDateTime;
        var services = await ReservationService.ListForDayAsync(RestaurantClock.Today(now, timeZoneId));
        if (services.Count == 0)
            return;

        var profile = await VitrineService.GetOrCreateProfileAsync();
        _reservations = ReservationDayView.From(services, now, profile.FreeCancellationHours);
        _nextGroup = _reservations.NextGroup(profile.GroupThreshold);
    }

    private static string WeekCaption(SevenDayFigures week) =>
        $"du {week.From.ToString("dd/MM", System.Globalization.CultureInfo.InvariantCulture)} au {week.To.ToString("dd/MM", System.Globalization.CultureInfo.InvariantCulture)} · ventes saisies et commandes";

    // Un chiffre des 7 jours dit où lire le détail : le lien mène aux statistiques.
    private RenderFragment Kpi(string label, string value, bool incomplete = false, string? caption = null) =>
        @<MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.overline" Style="color: var(--mud-palette-text-secondary)">@label</MudText>
            <MudText Typo="Typo.h3" HtmlTag="p">
                @value
                @if (incomplete)
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning" Class="ml-1" HtmlTag="span" title="Un prix manque : ce chiffre est partiel">(incomplet)</MudText>
                }
            </MudText>
            @if (caption is not null)
            {
                <MudText Typo="Typo.caption" HtmlTag="p" Style="color: var(--mud-palette-text-secondary)">
                    @caption · <MudLink Href="/stats">Voir les statistiques</MudLink>
                </MudText>
            }
        </MudPaper>;
}
