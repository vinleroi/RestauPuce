@page "/waste"

@using ChefOS.Core.Common
@using ChefOS.Infrastructure.Services

@inject WasteService WasteService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Pertes — ChefOS</PageTitle>

<div class="d-flex align-center flex-wrap gap-2 mb-4">
    <MudText Typo="Typo.h4" HtmlTag="h1" Class="flex-grow-1">Pertes</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync" Disabled="_busy">Déclarer une perte</MudButton>
</div>

<MudPaper Elevation="1" Class="pa-3 mb-4">
    <MudGrid Spacing="2" Class="align-center">
        <MudItem xs="6" md="3">
            <MudDatePicker Date="_from" DateChanged="SetFromAsync" Label="Du" Culture="Ui.Fr" DateFormat="dd/MM/yyyy" MaxDate="@Latest" Editable="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="6" md="3">
            <MudDatePicker Date="_to" DateChanged="SetToAsync" Label="Au" Culture="Ui.Fr" DateFormat="dd/MM/yyyy" MaxDate="@Latest" Editable="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudButton Variant="Variant.Text" OnClick="@(() => SetLastDaysAsync(7))">7 derniers jours</MudButton>
            <MudButton Variant="Variant.Text" OnClick="@(() => SetLastDaysAsync(30))">30 derniers jours</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable T="WasteItem" Items="_items" Hover="true" Dense="true" Loading="_loading" Elevation="1">
    <HeaderContent>
        <MudTh>Date</MudTh>
        <MudTh>Élément</MudTh>
        <MudTh Style="text-align: right">Quantité</MudTh>
        <MudTh>Motif</MudTh>
        <MudTh Style="text-align: right">Coût</MudTh>
        <MudTh Style="width: 1%"></MudTh>
    </HeaderContent>
    <RowTemplate>
        @* Le jour d'une perte est un jour de calendrier (minuit UTC) : il ne se convertit pas en heure locale. *@
        <MudTd DataLabel="Date" Style="white-space: nowrap">@context.Date.ToString("dd/MM/yyyy", Ui.Fr)</MudTd>
        <MudTd DataLabel="Élément">
            @context.ItemName
            @if (context.IsRecipe)
            {
                <MudChip T="string" Size="Size.Small" Class="ml-2">Recette</MudChip>
            }
            @if (!string.IsNullOrWhiteSpace(context.Note))
            {
                <MudText Typo="Typo.caption" Style="@Muted">@context.Note</MudText>
            }
        </MudTd>
        <MudTd DataLabel="Quantité" Style="white-space: nowrap; text-align: right">@Ui.QuantityText(context.Quantity, context.Unit, portions: context.IsRecipe)</MudTd>
        <MudTd DataLabel="Motif">@Ui.WasteReasonLabel(context.Reason)</MudTd>
        <MudTd DataLabel="Coût" Style="white-space: nowrap; text-align: right">
            @if (context.Cost is { } cost)
            {
                @((context.CostIncomplete ? "≥ " : "") + Ui.Money(cost))
            }
            else
            {
                <span>—</span>
            }
            @if (context.Cost is null || context.CostIncomplete)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Class="ml-2"
                         title="@(context.Cost is null ? "Coût inconnu : un prix manque" : "Coût partiel : certaines lignes de la recette n'ont pas de prix")">incomplet</MudChip>
            }
        </MudTd>
        <MudTd Style="white-space: nowrap; text-align: right">
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" title="Supprimer" Disabled="_busy"
                           aria-label="@($"Supprimer la perte de {context.ItemName}")" OnClick="() => DeleteAsync(context)" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Class="pa-4">Aucune perte déclarée sur cette période.</MudText>
    </NoRecordsContent>
</MudTable>

@if (!_loading && _items.Count > 0)
{
    <MudPaper Elevation="1" Class="pa-4 mt-4">
        <div class="d-flex align-center flex-wrap gap-2">
            <MudText Typo="Typo.h6">Total des pertes : @(TotalIncomplete ? "au moins " : "")@Ui.Money(Total)</MudText>
            @if (TotalIncomplete)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">incomplet</MudChip>
            }
        </div>
        @if (TotalIncomplete)
        {
            <MudText Typo="Typo.caption" Style="@Muted">
                Certaines pertes ont un coût inconnu ou partiel (prix manquant) : le total est un minimum.
            </MudText>
        }
    </MudPaper>
}

@code {
    private const string Muted = "color: var(--mud-palette-text-secondary)";

    private static readonly DialogOptions DialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    // Les pertes peuvent être datées de demain (UTC) : selon le fuseau du chef, demain peut déjà y être.
    private static DateTime Latest => DateTime.UtcNow.Date.AddDays(1);

    private IReadOnlyList<WasteItem> _items = [];
    private DateTime? _from = DateTime.UtcNow.Date.AddDays(-6);
    private DateTime? _to = DateTime.UtcNow.Date;
    private bool _loading = true;
    private bool _busy;

    // Les coûts inconnus ne s'additionnent pas : le total est un minimum dès qu'un coût manque ou n'est que partiel.
    private decimal Total => _items.Sum(item => item.Cost ?? 0m);

    private bool TotalIncomplete => _items.Any(item => item.Cost is null || item.CostIncomplete);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = _from is { } from && _to is { } to ? await WasteService.ListAsync(from, to) : [];
        }
        finally
        {
            _loading = false;
        }
    }

    private Task SetFromAsync(DateTime? date)
    {
        _from = date;
        return LoadAsync();
    }

    private Task SetToAsync(DateTime? date)
    {
        _to = date;
        return LoadAsync();
    }

    private Task SetLastDaysAsync(int days)
    {
        _to = DateTime.UtcNow.Date;
        _from = _to.Value.AddDays(1 - days);
        return LoadAsync();
    }

    private async Task AddAsync()
    {
        if (_busy)
            return;

        _busy = true;
        try
        {
            var dialog = await DialogService.ShowAsync<WasteDialog>("Déclarer une perte", DialogOptions);
            var result = await dialog.Result;
            if (result is { Canceled: false })
            {
                Snackbar.Add("Perte enregistrée", Severity.Success);

                // Une perte datée hors de la période affichée n'y apparaîtrait pas : on élargit la période pour qu'elle reste visible.
                if (result.Data is DateTime day)
                {
                    if (_from is null || day < _from)
                        _from = day;
                    if (_to is null || day > _to)
                        _to = day;
                }

                await LoadAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(WasteItem item)
    {
        if (_busy)
            return;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Supprimer la perte",
            $"Supprimer la perte de {Ui.QuantityText(item.Quantity, item.Unit, portions: item.IsRecipe)} de « {item.ItemName} » du {item.Date.ToString("dd/MM/yyyy", Ui.Fr)} ?",
            yesText: "Supprimer",
            cancelText: "Annuler");

        if (confirmed != true)
            return;

        _busy = true;
        try
        {
            await WasteService.DeleteAsync(item.Id);
            Snackbar.Add("Perte supprimée", Severity.Success);
        }
        catch (DomainValidationException e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }

        await LoadAsync();
    }
}
